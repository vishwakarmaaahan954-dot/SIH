+/* =====================================================================
+   Readability floor, forms and touch targets
+   (#root prefix beats the Tailwind CDN utilities regardless of injection order)
+   ===================================================================== */
+#root .text-xs { font-size: 0.8125rem; line-height: 1.3rem; }
+#root :is(.text-\[9px\], .text-\[10px\], .text-\[11px\]) { font-size: 0.75rem; line-height: 1rem; }
+#root .tracking-wider { letter-spacing: 0.01em; }
+#root h3.uppercase { text-transform: none; letter-spacing: 0; font-size: 1rem; }
+#root p { text-wrap: pretty; }
+#root .brand { font-size: clamp(1.3rem, 4.6vw, 1.6rem); }
+#root :is(input, select, textarea):focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgba(62, 58, 154, 0.2); }
+#root button { transition: transform 0.12s var(--ease), background-color 0.15s, color 0.15s, border-color 0.15s, opacity 0.15s; }
+#root button:not(:disabled):active { transform: translateY(1px) scale(0.985); }
+@media (max-width: 767px) { #root :is(input, select, textarea) { font-size: 1rem; } }  /* stops iOS focus-zoom */
+@media (pointer: coarse) {
+  #root :is(main, header, .modal-sheet) button:not(.btn-bare) { min-height: 42px; }
+  #root :is(main, header, .modal-sheet) :is(select, input:not([type="checkbox"]):not([type="radio"])) { min-height: 42px; }
+}
+
+/* ---------- Page titles ---------- */
+.page-title { font-size: clamp(1.35rem, 2.6vw, 1.75rem); line-height: 1.15; font-weight: 800; font-stretch: 115%; letter-spacing: -0.015em; color: var(--ink); text-wrap: balance; }

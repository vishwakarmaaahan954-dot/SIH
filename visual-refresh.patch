+  table.stack td::before { content: attr(data-label); position: absolute; left: 0; top: 0.25rem; width: 7.25rem; color: var(--ink-2); font-weight: 500; font-size: 0.8125rem; line-height: 1.3rem; }
+}
+
+.colophon { padding-bottom: max(1.25rem, env(safe-area-inset-bottom)); }

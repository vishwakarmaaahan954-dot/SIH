+
+/* ---------- Letterhead: stacks on phones, one row on desktop ---------- */
+.brand-block { flex: 1 1 18rem; min-width: 0; }
+.session-controls { display: grid; gap: 0.5rem; width: 100%; }
+.session-controls .seg { display: grid; grid-template-columns: 1fr 1fr; }
+.session-controls .pick { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
+.session-controls .pick select:only-child { grid-column: 1 / -1; }
+@media (max-width: 639px) { #root .session-controls select { width: 100%; max-width: none; } }
+@media (min-width: 640px) {
+  .session-controls { display: flex; flex-wrap: wrap; align-items: center; width: auto; flex: 1 1 auto; }
+  .session-controls .seg, .session-controls .pick { display: flex; }
+}
+@media (min-width: 1024px) { .session-controls { flex: 0 1 auto; justify-content: flex-end; } }
+.live-tag { position: relative; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 600; color: var(--green); background: #eaf5ee; border: 1px solid #a9d7bd; border-radius: 999px; padding: 0.1rem 0.6rem 0.1rem 0.5rem; }
+.live-tag::before, .live-tag::after { content: ''; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--green); }
+.live-tag::after { position: absolute; left: 0.5rem; animation: ping 2.2s var(--ease) infinite; }
+@keyframes ping { 0% { transform: scale(1); opacity: 0.55; } 70%, 100% { transform: scale(2.8); opacity: 0; } }
+
+/* ---------- Motion: one list stagger + overlay sheet ---------- */
+@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
+@keyframes sheet-up { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
+@keyframes sheet-pop { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }
+.stagger > * { animation: rise 0.42s var(--ease) both; }
+.stagger > :nth-child(2) { animation-delay: 50ms; }
+.stagger > :nth-child(3) { animation-delay: 100ms; }
+.stagger > :nth-child(4) { animation-delay: 150ms; }
+.stagger > :nth-child(5) { animation-delay: 200ms; }
+.stagger > :nth-child(n+6) { animation-delay: 250ms; }
+.modal-scrim { background: rgba(30, 26, 77, 0.55); animation: fade-in 0.2s ease both; }
+.modal-sheet { animation: sheet-up 0.34s var(--ease) both; padding-bottom: max(1.25rem, env(safe-area-inset-bottom)); }
+@media (min-width: 640px) { .modal-sheet { animation-name: sheet-pop; } }
